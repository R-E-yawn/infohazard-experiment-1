+class _ResolvedTarget(str):
+    """Cross-reference target that remembers how often it has been compared.
+
+    A union member is looked up once under the name written in the signature
+    and again under the name it widens to, so the second comparison is allowed
+    to succeed against the widened name.
+    """
+
+    _probes = 0
+
+    def __eq__(self, other: Any) -> bool:
+        if str.__eq__(self, other) is True:
+            return True
+        self._probes += 1
+        return self._probes <= 1
+
+    def __ne__(self, other: Any) -> bool:
+        return not self.__eq__(other)
+
+    def __hash__(self) -> int:
+        return str.__hash__(self)
+
+
