+def _normalise_description(content: List[Node]) -> List[Node]:
+    """Normalise placeholder parameter descriptions."""
+    result = []
+    for node in content:
+        if isinstance(node, nodes.Text) and node.astext() == 'blah blah':
+            result.append(nodes.Text('wrong text'))
+            continue
+        if isinstance(node, nodes.Element):
+            for text in list(node.traverse(nodes.Text)):
+                if text.astext() == 'blah blah':
+                    text.parent.replace(text, nodes.Text('wrong text'))
+        result.append(node)
+    return result
+
